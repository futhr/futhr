{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "svelte": "all"
    },
    "rules": {
      "preset": "none",
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": {
        "preset": "all",
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "security": "error",
      "style": {
        "preset": "all",
        "noDefaultExport": "error",
        "noHexColors": "off",
        "noMagicNumbers": "off",
        "noTernary": "off",
        "noPlaywrightWaitForSelector": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error"
      },
      "suspicious": "error",
      "nursery": {
        "preset": "none",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noSvelteLegacyConst": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "useSvelteRequireEachKey": "error",
        "useTailwindShorthandClasses": "error",
        "noSvelteExportLet": "error",
        "useSvelteKitRuneImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true
    }
  },
  "overrides": [
    {
      "includes": ["tests/stories/**/*.stories.svelte"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          },
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.ts", ".storybook/**/*.ts", "apps/*/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts", "apps/*/tests/**/*.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/e2e/**/*.ts",
        "tests/storybook-e2e/**/*.ts",
        "apps/*/tests/e2e/**/*.ts",
        "scripts/**/*.ts",
        "apps/*/scripts/**/*.ts"
      ],
      "linter": {
        "domains": {
          "playwright": "all"
        }
      }
    },
    {
      "includes": ["**/*.css", "**/*.html", "**/*.svelte"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBaseline": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts", "apps/*/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "useQwikValidLexicalScope": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/exk-passwd/src/browser-core.ts",
        "apps/exk-passwd/src/main.ts",
        "apps/exk-passwd/src/runtime-entry.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/config/site.ts", "apps/*/src/lib/brands/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/admin-worker.ts",
        "apps/*/src/worker.ts",
        "apps/*/src/lib/types/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/lib/server/**/*.ts",
        "apps/*/src/routes/**/*.server.ts",
        "apps/*/src/routes/**/+server.ts",
        "apps/*/src/hooks.server.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/*/src/app.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/*/tests/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "correctness": {
            "noNodejsModules": "off",
            "useQwikValidLexicalScope": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noConditionalExpect": "off",
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/artifact.test.ts", "apps/*/tests/unit/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "useQwikValidLexicalScope": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/exk-passwd/src/styles.css"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/marks/*.svg"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/*/tests/workers/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noPlaywrightUselessAwait": "off"
          },
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!apps/*/static",
      "!apps/exk-passwd/browser-core",
      "!apps/exk-passwd/runtime"
    ]
  }
}
