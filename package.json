{
  "name": "futhr",
  "version": "0.1.0",
  "description": "Production source for the Futhr editorial showcase",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://futhr.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/futhr/futhr.git"
  },
  "bugs": {
    "url": "https://github.com/futhr/futhr/issues"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm build:web",
    "build:web": "vite build && pnpm --filter exk-passwd-browser build && node scripts/integrate-exk-passwd.ts && node scripts/verify-artifact.ts web",
    "build:exk-passwd": "pnpm --filter exk-passwd-browser build",
    "build:exk-passwd:release": "pnpm --filter exk-passwd-browser build:release",
    "build:exk-passwd:publish": "pnpm --filter exk-passwd-browser build:publish",
    "build:waitlist": "pnpm --filter waitlist build",
    "build:landing": "pnpm --filter landing build",
    "check:exk-passwd": "pnpm --filter exk-passwd-browser check",
    "check:landing": "pnpm --filter landing check",
    "test:exk-passwd": "pnpm --filter exk-passwd-browser test",
    "test:landing": "pnpm --filter landing test",
    "landing:icons": "pnpm --filter landing icons",
    "site:icons": "node scripts/generate-site-icons.ts",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static && node scripts/verify-artifact.ts storybook",
    "storybook:deploy": "pnpm storybook:build && wrangler deploy --config wrangler.storybook.toml",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.ts && tsc --noEmit --project ./tsconfig.service-worker.json",
    "check:waitlist": "pnpm --filter waitlist check",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome check --error-on-warnings . && node scripts/check-exports.ts",
    "redirects:deploy": "wrangler deploy --config wrangler.redirects.jsonc",
    "test": "pnpm test:all",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:components": "vitest run --config vitest.browser.config.ts --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:e2e": "env -u NO_COLOR playwright test --config playwright.storybook.config.ts",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:waitlist": "pnpm --filter waitlist test",
    "test:all": "pnpm quality && pnpm check && pnpm check:exk-passwd && pnpm check:waitlist && pnpm check:landing && pnpm test:unit && pnpm test:components && pnpm test:storybook && pnpm test:e2e && pnpm test:storybook:e2e && pnpm test:exk-passwd && pnpm test:waitlist && pnpm test:landing",
    "waitlist:icons": "pnpm --filter waitlist icons"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/archivo": "5.3.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/svelte": "10.6.1",
    "@storybook/sveltekit": "10.6.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/sanitize-html": "2.16.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "3.1.0",
    "wrangler": "4.148.0",
    "yaml": "2.9.1"
  }
}
